{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "life-portal": {
      "type": "streamable-http",
      "url": "https://life-portal.onrender.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://life-portal.onrender.com/api/mcp",
            "defaultScopes": ["nutrition"]
          }
        }
      }
    }
  }
}
