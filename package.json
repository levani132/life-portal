{
  "name": "@life-portal/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx nx run-many --targets=serve,dev --projects=api,web --parallel",
    "dev:api": "npx nx serve api",
    "dev:web": "npx nx dev web",
    "build": "npx nx run-many -t build --projects=api,web",
    "build:api": "npx nx build api",
    "build:web": "npx nx build web",
    "start:api": "node dist/apps/api/main.js",
    "seed": "npx tsx apps/api/src/seed/seed.ts",
    "test": "npx nx run-many -t test",
    "lint": "npx nx run-many -t lint",
    "typecheck": "npx tsc -p apps/api/tsconfig.app.json --noEmit && npx tsc -p apps/web/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
