{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci --no-audit --no-fund",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://life-portal.onrender.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-lp-proxy"
          },
          "args": "$LP_PROXY_SECRET",
          "env": [
            "LP_PROXY_SECRET"
          ]
        }
      ]
    }
  ]
}
