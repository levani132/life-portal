# ---------------------------------------------------------------- required
# The API refuses to boot without these two.

# MongoDB Atlas connection string. Create a free M0 cluster at cloud.mongodb.com,
# add a database user, allow your IP (or 0.0.0.0/0 for a free host), then copy the
# driver connection string and append a database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/life-portal?retryWrites=true&w=majority

# At least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------- recommended

# When set, POST /auth/register requires this code. Leave blank locally; SET IT IN
# PRODUCTION, otherwise anyone who finds your URL can create an account.
REGISTRATION_INVITE_CODE=

# Explicit account ID for the sole developer (find your ID in GET /api/auth/me).
# This enables all modules including EPAM and the Feature access screen in Menu.
# Existing accounts without a cohort retain internal access to general modules.
DEVELOPER_USER_ID=

# Live share prices. Free key from finnhub.io/register (60 calls/minute).
# Without it the app works fine, but prices must be entered by hand.
FINNHUB_API_KEY=

# ---------------------------------------------------------------- optional

# API port. Named API_PORT rather than PORT on purpose: `next dev` also reads PORT, so a
# shared PORT makes the web app and the API fight over the same socket. Managed hosts that
# inject PORT still work — the API falls back to it.
API_PORT=3333

# The web app's port is pinned to 4200 in apps/web/project.json, so it needs no variable here.

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Enable OAuth sign-in for assistants on phones and other remote clients.
# Canonical PUBLIC API origin, without /api or a trailing path. HTTPS in production.
# Leave blank to keep only manually generated MCP tokens.
# Production example: https://life-portal.onrender.com
# Development example: http://localhost:3333
MCP_OAUTH_ISSUER=

# Token lifetimes in SECONDS (not "15m" strings — see docs/DECISIONS.md).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Set true to skip the daily quote-refresh cron. Refresh stays available at
# POST /api/stocks/refresh.
DISABLE_SCHEDULES=false

# Food lookups use Open Food Facts, which needs NO API key — but it does require a custom
# User-Agent, and answers generic ones with rate limits or a block. Either set the whole agent
# yourself, or set a contact address and let the app build `LifePortal/1.0 (<address>)`.
# Both are optional: without them the app sends a generic agent and, if the lookup is refused,
# food entry still works by hand.
OFF_USER_AGENT=
OFF_CONTACT_EMAIL=

# Push notifications (Web Push / VAPID). Set all three or none: without them the feature is
# hidden and everything else works; a partial set refuses to boot. Generate the pair once with
#   npx web-push generate-vapid-keys
# and keep it — changing the keys invalidates every device's subscription (each app
# re-registers on its next start). The subject is a contact for push services:
# mailto:you@example.com or an https:// URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Photos and video in posts: a private Cloudflare R2 bucket (S3 API). Set all four or none:
# without them the composer offers no photos or camera; a partial set refuses to boot. The
# endpoint is https://<account id>.r2.cloudflarestorage.com. Use an API token scoped to this one
# bucket with object read & write. The bucket needs a CORS rule allowing PUT and GET with the
# content-type header from the web origins (see docs/modules/posts.md).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- seed

# Used only by `npm run seed`.
SEED_EMAIL=levan.beroshvili@ext.innolink.ai
SEED_NAME=Levan
SEED_PASSWORD=

# ---------------------------------------------------------------- web

# Baked into the web bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3333/api
# Optional: the API's absolute URL for server-side reads (link previews) when
# NEXT_PUBLIC_API_URL is relative, e.g. https://life-portal-api.onrender.com/api
# API_INTERNAL_URL=

# Apple Health Shortcut sharing URL is managed by the developer in app Settings.
