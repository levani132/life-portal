# ---------------------------------------------------------------- required
# The API refuses to boot without these two.

# MongoDB Atlas connection string. Create a free M0 cluster at cloud.mongodb.com,
# add a database user, allow your IP (or 0.0.0.0/0 for a free host), then copy the
# driver connection string and append a database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/life-portal?retryWrites=true&w=majority

# At least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------- recommended

# When set, POST /auth/register requires this code. Leave blank locally; SET IT IN
# PRODUCTION, otherwise anyone who finds your URL can create an account.
REGISTRATION_INVITE_CODE=

# Live share prices. Free key from finnhub.io/register (60 calls/minute).
# Without it the app works fine, but prices must be entered by hand.
FINNHUB_API_KEY=

# ---------------------------------------------------------------- optional

# API port. Named API_PORT rather than PORT on purpose: `next dev` also reads PORT, so a
# shared PORT makes the web app and the API fight over the same socket. Managed hosts that
# inject PORT still work — the API falls back to it.
API_PORT=3333

# The web app's port is pinned to 4200 in apps/web/project.json, so it needs no variable here.

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Token lifetimes in SECONDS (not "15m" strings — see docs/DECISIONS.md).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Set true to skip the daily quote-refresh cron. Refresh stays available at
# POST /api/stocks/refresh.
DISABLE_SCHEDULES=false

# ---------------------------------------------------------------- seed

# Used only by `npm run seed`.
SEED_EMAIL=levan.beroshvili@ext.innolink.ai
SEED_NAME=Levan
SEED_PASSWORD=

# ---------------------------------------------------------------- web

# Baked into the web bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3333/api
